{
  "defaultProvider": "openrouter",
  "defaultModel": "anthropic/claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "subagents": {
    "defaultProvider": "anthropic",
    "defaultModel": "anthropic/claude-sonnet-5-5",
    "defaultThinking": "medium",
    "maxThinking": "xhigh",
    "toolActivation": "eager",
    "defaultSubagentOnlyExtensions": [
      ".pi/extensions/free-first-router.ts"
    ],
    "agentOverrides": {
      "scout": {
        "model": "anthropic/claude-haiku-5-5",
        "thinking": "low",
        "advertise": true
      },
      "researcher": {
        "model": "anthropic/claude-haiku-5-5",
        "thinking": "medium",
        "advertise": true
      },
      "worker": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "high",
        "advertise": true
      },
      "oracle": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "high",
        "advertise": true
      },
      "delegate": {
        "model": "anthropic/claude-haiku-5-5",
        "thinking": "medium",
        "advertise": true
      },
      "evidence-auditor": {
        "model": "anthropic/claude-haiku-5-5",
        "thinking": "low"
      },
      "android-emulator": {
        "model": "anthropic/claude-haiku-5-5",
        "thinking": "low",
        "advertise": true
      }
    }
  }
}
